{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "distribution": "store",
      "developmentClient": false,
      "autoIncrement": true
    },
    "minimal": {
      "ios": {
        "resourceClass": "m-medium"
      },
      "distribution": "internal",
      "developmentClient": false
    },
    "test": {
      "ios": {
        "resourceClass": "m-medium"
      },
      "distribution": "internal",
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_TEST_MODE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
