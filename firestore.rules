rules_version = '2';

// Caval Firestore rules — shared by the driver app (DriverApp-Caval),
// the customer app (Caval-Customer-Clean) and Cloud Functions.
// Cloud Functions use the Admin SDK and bypass these rules entirely.
// Driver approval is done by an admin in the Firebase Console, which also
// bypasses these rules (see ADMIN_APPROVAL_INSTRUCTIONS.md).
//
// Pricing, ride assignment and driver earnings are done by Cloud Functions
// (selectBestDriverForNewRideRequest, declineRide, handleRideStatusChange).
// The apps can't set a ride's price, assign a ride, or write earnings.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isSelf(id) { return signedIn() && request.auth.uid == id; }
    function isDriver() {
      return signedIn() && exists(/databases/$(database)/documents/Drivers/$(request.auth.uid));
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyChanges(keys) { return changedKeys().hasOnly(keys); }
    function noChangesTo(keys) { return !changedKeys().hasAny(keys); }

    // Ride fields only Cloud Functions may set.
    function rideServerFields() {
      return ['fareSource', 'billedDistanceKm', 'clientFare', 'earningsRecordedAt',
              'lastDeclinedBy', 'lastDeclinedAt', 'replacedBy', 'retryOf', 'customerDeletedAt'];
    }

    // Private driver data lives in Drivers/{id}/private/profile, not on the
    // driver doc that every signed-in user can read.
    function driverPrivateFields() { return ['carteGrisePhoto', 'paymentMethods']; }

    // Fields only an admin (Console) or Cloud Functions may set on a driver.
    function driverAdminFields() {
      return ['isApproved', 'approvalStatus', 'approvalDate', 'approvedBy',
              'documentsVerified',
              'earnings', 'totalEarnings', 'weeklyEarnings', 'dailyEarnings',
              'ratings', 'averageRating', 'totalRatings'];
    }

    // ---------- Drivers ----------
    match /Drivers/{driverId} {
      // Customers need driver name/photo/car; drivers need each other for assignment.
      allow read: if signedIn();

      // A driver can only register themselves, and only as pending.
      allow create: if isSelf(driverId)
        && !request.resource.data.keys().hasAny(driverPrivateFields())
        && request.resource.data.get('isApproved', false) == false
        && request.resource.data.get('approvalStatus', 'pending') == 'pending'
        && request.resource.data.get('approvedBy', null) == null
        && request.resource.data.get('documentsVerified', false) == false
        && request.resource.data.get('earnings', 0) == 0
        && request.resource.data.get('totalEarnings', 0) == 0
        && request.resource.data.get('weeklyEarnings', 0) == 0
        && request.resource.data.get('dailyEarnings', 0) == 0;

      allow update: if
        // Driver edits own profile/status/location, but never approval,
        // money or rating fields. (Ratings go through the rateDriver function.)
        isSelf(driverId) && noChangesTo(driverAdminFields())
            && !request.resource.data.diff(resource.data).addedKeys().hasAny(driverPrivateFields())
            && !request.resource.data.diff(resource.data).changedKeys().hasAny(driverPrivateFields());

      allow delete: if isSelf(driverId);   // account deletion (SettingsScreen)

      // Registration documents and payout details: owner only.
      match /private/{docId} {
        allow read, write: if isSelf(driverId);
      }
    }

    // ---------- Customers ----------
    match /Customers/{customerId} {
      allow read, create, update, delete: if isSelf(customerId);
    }

    // ---------- Users (legacy profile docs) ----------
    match /Users/{userId} {
      allow read, write: if isSelf(userId);
    }

    // ---------- rideRequests ----------
    match /rideRequests/{rideId} {
      allow read: if isDriver()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // Customers create their own ride request, unassigned.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        // RideOptionsScreen sends status 'waiting'; HomeScreenWithMap sends none.
        && request.resource.data.get('status', 'waiting') == 'waiting'
        && request.resource.data.get('driverId', null) == null
        && request.resource.data.get('selectedDriverId', null) == null
        && !request.resource.data.keys().hasAny(rideServerFields());

      allow update: if
        // Only the driver the ride is offered to / assigned to can update it
        // (accept, progress, complete). They can't reassign it, re-price it,
        // or change who booked it or the route.
        (isDriver()
            && request.auth.uid in [resource.data.get('driverId', null),
                                    resource.data.get('selectedDriverId', null)]
            && noChangesTo(['userId', 'fare', 'rideType', 'paymentMethod', 'distance',
                            'pickupLat', 'pickupLng', 'destinationLat', 'destinationLng',
                            'createdAt', 'selectedDriverId', 'declinedDrivers'])
            && noChangesTo(rideServerFields())
            && (!changedKeys().hasAny(['driverId'])
                || request.resource.data.driverId == request.auth.uid))
        // Customers can only cancel their own ride.
        || (signedIn() && resource.data.userId == request.auth.uid
            && onlyChanges(['status', 'cancelledAt', 'cancelledBy',
                            'cancellationReason', 'updatedAt'])
            && request.resource.data.status in ['declined', 'cancelled']);

      allow delete: if false;
    }

    // Customer contact info attached to a ride, read by the assigned driver.
    match /rideRequestsDriver/{docId} {
      function rideOwner(rideRequestId) {
        return get(/databases/$(database)/documents/rideRequests/$(rideRequestId)).data.userId;
      }
      allow read: if isDriver()
        || (signedIn() && rideOwner(resource.data.rideRequestId) == request.auth.uid);
      allow create: if signedIn()
        && rideOwner(request.resource.data.rideRequestId) == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- SelectedDriver (ride offers, created by Cloud Functions) ----------
    match /SelectedDriver/{rideId} {
      allow read: if isDriver();
      // The offered driver can mark it accepted/assigned/rejected.
      allow update: if signedIn()
        && resource.data.get('selectedDriverId', null) == request.auth.uid
        && noChangesTo(['selectedDriverId', 'rideId']);
      allow create, delete: if false;
    }

    // ---------- OnlineDriver summary (written by Cloud Functions) ----------
    match /OnlineDriver/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- Driver-private data ----------
    // Earnings are written only by Cloud Functions (on ride completion).
    match /Earnings/{driverId}         { allow read: if isSelf(driverId); allow write: if false; }
    match /PaymentMethods/{driverId}   { allow read, write: if isSelf(driverId); }
    match /driverStats/{driverId}      { allow read, write: if isSelf(driverId); }
    match /DriverPushTokens/{driverId} { allow read, write: if isSelf(driverId); }

    // Daily earnings ledger: doc id is `${driverId}_${YYYYMMDD}`.
    // Written only by Cloud Functions; the driver can read their own.
    match /moneyByRider/{docId} {
      allow read: if signedIn() && docId.matches(request.auth.uid + '_[0-9]{8}');
      allow write: if false;
    }

    // ---------- Customer payment methods ----------
    match /paymentMethods/{docId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- Ratings: written by the rateDriver function ----------
    match /driverRatings/{ratingId} {
      allow read: if signedIn()
        && request.auth.uid in [resource.data.get('driverId', null), resource.data.get('customerId', null)];
      allow write: if false;
    }

    // ---------- Conversations ----------
    match /conversations/{conversationId} {
      function isParticipant(data) {
        return signedIn() && (
          request.auth.uid == data.get('customerId', null)
          || request.auth.uid == data.get('driverId', null)
          || request.auth.uid in data.get('participants', [])
        );
      }

      allow read: if isParticipant(resource.data);
      allow create: if isParticipant(request.resource.data);
      allow update: if isParticipant(resource.data)
        && noChangesTo(['customerId', 'driverId', 'participants']);
      allow delete: if false;

      match /messages/{messageId} {
        function parent() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        allow read, create, update: if isParticipant(parent());
        allow delete: if false;
      }
    }

    // Everything else (test, SystemMetrics, legacy `drivers`, …) is
    // Cloud-Functions / Console only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
