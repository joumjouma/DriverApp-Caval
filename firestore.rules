rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEVELOPMENT RULES - Very permissive for testing
    // TODO: Make more restrictive for production
    
    // Allow all authenticated users to read/write all documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // Specific rules for better security (commented out for development)
    /*
    // Allow authenticated users to read/write their own driver data
    match /Drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
      // Allow reading other drivers for ride matching
      allow read: if request.auth != null;
    }
    
    // Allow authenticated users to read/write ride requests
    match /rideRequests/{rideId} {
      allow read, write: if request.auth != null;
    }
    
    // REMOVED: DriverSelection collection is deprecated
    // Using SelectedDriver collection instead
    
    // Allow authenticated users to read/write online driver data
    match /OnlineDriver/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write money by rider data
    match /moneyByRider/{document} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write conversations
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null;
    }
    */
  }
} 